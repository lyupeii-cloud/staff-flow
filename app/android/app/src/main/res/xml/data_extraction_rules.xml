<?xml version="1.0" encoding="utf-8"?>
<!-- Jeton de session et copie hors ligne : ni dans la sauvegarde Google, ni
     dans le transfert vers un nouveau téléphone (on s'y reconnecte). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
