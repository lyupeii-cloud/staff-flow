# Adresse de l'application, et APP_DOMAIN (nouvelle adresse, facultative).
{$DOMAIN} {$APP_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	handle /api/* {
		reverse_proxy api:8080
	}
	handle /health {
		reverse_proxy api:8080
	}

	# Application Flutter : toute autre adresse renvoie index.html.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
