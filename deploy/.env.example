# Copier en deploy/.env sur le serveur et remplir. Ne jamais committer .env.
DOMAIN=planning.example.com

# Générer : openssl rand -base64 32
POSTGRES_PASSWORD=
SESSION_SECRET=
BACKUP_PASSPHRASE=

# Google Cloud Console > API et services > Identifiants
GOOGLE_WEB_CLIENT_ID=xxxx.apps.googleusercontent.com
# Audiences acceptées par l'API (client Web ; Android utilise le client Web comme serverClientId)
GOOGLE_CLIENT_IDS=xxxx.apps.googleusercontent.com

BACKUP_DIR=/var/backups/staff-flow
