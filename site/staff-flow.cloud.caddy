# Site vitrine Staff Flow (fichiers dans /home/debian/hosting/www/staff-flow.cloud).
# Source : dépôt staff-flow, dossier site/ (dart tool/build.dart, puis copie de www/).
staff-flow.cloud {
	encode zstd gzip

	header {
		-Server
		Strict-Transport-Security "max-age=31536000"
		# Le navigateur ne charge que les fichiers du site : aucun script ni service tiers.
		Content-Security-Policy "default-src 'none'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
		Cross-Origin-Opener-Policy same-origin
	}

	# Images et polices : en cache une semaine ; pages : toujours revérifiées.
	header /img/* Cache-Control "public, max-age=604800"
	header /fonts/* Cache-Control "public, max-age=31536000, immutable"
	header /*.html Cache-Control "no-cache"

	# Accueil : la langue du navigateur (ukrainien, russe → /uk/ ; français → /fr/ ; sinon /en/).
	@uk {
		path /
		header_regexp Accept-Language ^\s*(uk|ru)
	}
	redir @uk /uk/ 302
	@fr {
		path /
		header_regexp Accept-Language ^\s*fr
	}
	redir @fr /fr/ 302
	@other {
		path /
		header Accept-Language *
	}
	redir @other /en/ 302

	@prive path /.*
	respond @prive 404

	root * /var/www/staff-flow.cloud
	file_server
	handle_errors {
		redir * /
	}
}

www.staff-flow.cloud {
	header -Server
	redir https://staff-flow.cloud{uri} permanent
}
